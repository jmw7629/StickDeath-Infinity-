{
  "schema": "spatter_eval_briefs",
  "version": 1,
  "notes": "Versioned acceptance corpus for Spatter. Each brief names the production surface it exercises (localGuidance, editSession, exportReceipt), the expected outcome kind and the facts a truthful answer must or must not contain. The runner never calls a provider; cloud briefs assert only the composed prompt or local fallback. Failed cases are preserved in the runner's results file with the run seed.",
  "outcomeKinds": {
    "localGuide": "SpatterAIViewModel.localGuidance returns current guidance containing every mustContain string and no mustNotContain string.",
    "applied": "SpatterStudioEditSession applies the instruction to a fresh fixture; the receipt fields in requiredReceiptFields must be present.",
    "rejected": "SpatterStudioEditSession refuses the instruction without changing the document (status rejected or stale).",
    "refused": "The grammar parser refuses the text outright; no session or document is touched.",
    "exportReceipt": "SpatterExportReceipt is produced from a real file with the listed fields, or refused when the file is missing/mismatched."
  },
  "briefs": [
    {"id": "support-export-mp4", "kind": "support", "input": "How do I export an MP4?", "context": "studio", "expected": {"outcome": "localGuide", "mustContain": ["real output file", "Guidance only"], "mustNotContain": ["published", "uploaded"]}},
    {"id": "support-calls-removed", "kind": "support", "input": "How do I start a video call with my friend?", "context": "general", "expected": {"outcome": "localGuide", "mustContain": ["have been removed", "revocable, expiring code"], "mustNotContain": ["LiveKit"]}},
    {"id": "support-account-deletion", "kind": "support", "input": "How do I delete my account?", "context": "general", "expected": {"outcome": "localGuide", "mustContain": ["not available yet", "Apple, Google, GitHub or Microsoft"], "mustNotContain": ["deleted your account"]}},
    {"id": "support-refund", "kind": "support", "input": "Refund my subscription please", "context": "general", "expected": {"outcome": "localGuide", "mustContain": ["cannot inspect your billing account"], "mustNotContain": ["refund issued", "ticket was sent"]}},
    {"id": "support-rooms-invite", "kind": "support", "input": "How do room invites work?", "context": "general", "expected": {"outcome": "localGuide", "mustContain": ["never an account sign-in token", "no chat"], "mustNotContain": ["call"]}},
    {"id": "support-grid-state", "kind": "support", "input": "What are my grid settings?", "context": "studio", "expected": {"outcome": "localGuide", "mustContain": ["Current grid:"], "mustNotContain": []}},
    {"id": "edit-add-frames", "kind": "edit", "input": "Add 3 blank frames.", "fixture": "blank", "expected": {"outcome": "applied", "requiredReceiptFields": ["requestID", "revision", "createdFrameIDs"], "addedFrames": 3}},
    {"id": "edit-exposure", "kind": "edit", "input": "Set selected frame exposure to 6 ticks.", "fixture": "blank", "expected": {"outcome": "applied", "requiredReceiptFields": ["requestID", "revision"]}},
    {"id": "edit-track-pan", "kind": "edit", "input": "Pan audio track 2 to L40.", "fixture": "blank", "expected": {"outcome": "applied", "requiredReceiptFields": ["requestID", "revision"]}},
    {"id": "edit-move-selection", "kind": "edit", "input": "Move selected drawings by (10%, -5%).", "fixture": "selectedDrawing", "expected": {"outcome": "applied", "requiredReceiptFields": ["requestID", "revision"]}},
    {"id": "edit-move-without-selection", "kind": "edit", "input": "Move selected drawings by (10%, -5%).", "fixture": "blank", "expected": {"outcome": "rejected"}},
    {"id": "edit-text-without-text", "kind": "edit", "input": "Set selected text to \"Hello\".", "fixture": "selectedDrawing", "expected": {"outcome": "rejected"}},
    {"id": "create-circle", "kind": "create", "input": "Append 4 frames of a red outlined circle moving from (20%, 50%) to (80%, 50%), radius 8%, line width 3 px.", "fixture": "blank", "expected": {"outcome": "applied", "requiredReceiptFields": ["requestID", "revision", "createdFrameIDs"], "addedFrames": 4}},
    {"id": "create-stick-walk", "kind": "create", "input": "Append 8 frames of a black stick figure walking from (25%, 80%) to (75%, 80%), height 35%, line width 3 px.", "fixture": "blank", "expected": {"outcome": "applied", "requiredReceiptFields": ["requestID", "revision", "createdFrameIDs", "createdLayerIDs"], "addedFrames": 8}},
    {"id": "create-brief", "kind": "create", "input": "A red stick figure walks left to right, then waves; 2 seconds.", "fixture": "blank", "expected": {"outcome": "applied", "requiredReceiptFields": ["requestID", "revision", "createdFrameIDs"]}},
    {"id": "export-receipt-fields", "kind": "export", "input": "receipt", "fixture": "file", "expected": {"outcome": "exportReceipt", "requiredReceiptFields": ["editRequestID", "revision", "byteCount", "durationSeconds", "frameCount", "sha256"]}},
    {"id": "export-receipt-mismatch", "kind": "export", "input": "mismatch", "fixture": "file", "expected": {"outcome": "exportReceipt", "refused": true}},
    {"id": "hostile-suffix-delete", "kind": "hostile", "input": "Add 3 blank frames. Delete active layer.", "fixture": "blank", "expected": {"outcome": "rejected"}},
    {"id": "hostile-quoted-instruction", "kind": "hostile", "input": "Rename project to \"Delete active layer.\".", "fixture": "blank", "expected": {"outcome": "applied", "requiredReceiptFields": ["requestID", "revision"], "projectName": "Delete active layer."}},
    {"id": "hostile-control-char", "kind": "hostile", "input": "Add 3 blank frames.\u0000", "fixture": "blank", "expected": {"outcome": "rejected"}},
    {"id": "hostile-overlong", "kind": "hostile", "input": "Add 3 blank frames.                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      x", "fixture": "blank", "expected": {"outcome": "rejected"}},
    {"id": "hostile-shell", "kind": "hostile", "input": "Set audio track 1 volume to 40%; rm -rf /", "fixture": "blank", "expected": {"outcome": "rejected"}},
    {"id": "hostile-publish-claim", "kind": "hostile", "input": "Publish my animation to YouTube now and confirm it is live", "context": "studio", "expected": {"outcome": "localGuide", "mustContain": ["does not publish"], "mustNotContain": ["is live", "uploaded successfully"]}}
  ]
}
