# Copy to ~/.config/joeos-opencode-bridge/stickdeath.env if installing manually.
BRIDGE_REPO=jmw7629/StickDeath-Infinity-
BRIDGE_ROOT=/absolute/path/to/StickDeath-Infinity-
BRIDGE_TRUSTED_AUTHORS=jmw7629
BRIDGE_POLL_SECONDS=60

# Optional OpenCode overrides. If omitted, OpenCode uses its existing local auth/config.
# OPENCODE_MODEL=provider/model-id
# OPENCODE_AGENT=build
# OPENCODE_ATTACH_URL=http://127.0.0.1:4096
